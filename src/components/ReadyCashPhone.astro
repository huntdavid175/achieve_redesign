---
/*
  Placeholder artwork for "Share Your Referral Link".
*/
---

<div class="relative aspect-[860/1864] w-full overflow-hidden rounded-[24px] bg-[#08090A] ring-1 ring-white/10">
	<div class="flex items-center justify-between px-5 pt-6">
		<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" class="size-[15px]">
			<path d="M19 12H5m0 0 6-6m-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
		<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" class="size-[15px]">
			<circle cx="12" cy="12" r="9.4"></circle>
			<path d="M12 7.4v5.2" stroke-linecap="round"></path>
			<circle cx="12" cy="16.4" r="1" fill="#fff" stroke="none"></circle>
		</svg>
	</div>

	<!-- avatar placeholder -->
	<div class="mt-8 flex justify-center">
		<span
			class="flex size-[63px] items-center justify-center overflow-hidden rounded-full bg-[linear-gradient(160deg,#F7C4AE,#EFA087)]"
		>
			<svg viewBox="0 0 24 24" fill="#7A4B3A" class="size-[44px] translate-y-[6px] opacity-80">
				<circle cx="12" cy="8.4" r="4.4"></circle>
				<path d="M4.4 22a7.6 7.6 0 0 1 15.2 0Z"></path>
			</svg>
		</span>
	</div>

	<p class="mt-4 text-center text-[17px] font-bold text-white">Refer &amp; Earn</p>

	<div class="mt-3 flex justify-center">
		<span class="rounded-full border border-white/25 px-3 py-1.5 text-[9px] text-white/80">
			achieve.app/r/amamensah
		</span>
	</div>

	<div class="mt-7 px-5">
		<div class="rounded-[12px] bg-[#1A1B1D] py-3 text-center text-[19px] font-bold text-white">
			40 Points
		</div>
	</div>

	<!-- lavender card peeking from the bottom edge -->
	<div class="absolute inset-x-6 -bottom-4 h-[52px] rounded-t-[14px] bg-[#C4EDE2]"></div>
</div>
