---
/*
  Placeholder artwork for "Withdraw On Your Own Terms".
  Built in markup so it stays crisp; swap for a real screenshot when available.
*/
const contacts = [
	{ bg: 'bg-[linear-gradient(150deg,#3ED98F,#4FA85E)]', size: 'size-[41px]' },
	{ bg: 'bg-[linear-gradient(150deg,#6FC98B,#3E9E6B)]', size: 'size-[41px]' },
	{ bg: 'bg-[linear-gradient(150deg,#FFD24A,#F2A93B)]', size: 'size-[48px]' },
	{ bg: 'bg-[linear-gradient(150deg,#6FA8E8,#3F76C4)]', size: 'size-[41px]' },
	{ bg: 'bg-[linear-gradient(150deg,#63CFE8,#3AA5C9)]', size: 'size-[41px]' },
];
---

<div class="relative aspect-[860/1864] w-full overflow-hidden rounded-[30px] bg-[#050506] ring-1 ring-white/10">
	<!-- header -->
	<div class="flex items-center px-5 pt-6">
		<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" class="size-[15px]">
			<path d="M14 5.5 7.5 12l6.5 6.5" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
		<span class="flex-1 text-center text-[13px] font-bold text-white">Withdraw</span>
		<span class="size-[15px]"></span>
	</div>

	<!-- contact carousel, edges intentionally running off the screen -->
	<div class="mt-6 flex items-center justify-center gap-2.5">
		{
			contacts.map((c) => (
				<span class:list={['shrink-0 rounded-full ring-2 ring-white/10', c.bg, c.size]} />
			))
		}
	</div>

	<div class="mt-3 text-center">
		<p class="text-[13px] font-bold text-white">Ama Mensah</p>
		<p class="mt-0.5 text-[9px] text-white/45">+233 24 000 0000</p>
	</div>

	<p class="mt-4 text-center text-[20px] font-bold tracking-tight text-white">GHS 7,857.00</p>

	<div class="mt-4 flex items-center justify-center gap-2">
		<span class="rounded-full bg-[#3ED9B4] px-3 py-1.5 text-[9px] font-bold text-[#1B1B1E]">
			Standard &middot; Free
		</span>
		<span class="rounded-full bg-[#1B1B1E] px-3 py-1.5 text-[9px] font-medium text-white/80">
			Express &middot; 1.2%
		</span>
	</div>

	<div class="mt-7 px-5">
		<p class="text-[14px] font-bold text-white">Withdraw to</p>
		<div class="mt-3 flex items-center gap-2.5 rounded-[14px] bg-[#161618] px-3 py-3">
			<span class="flex shrink-0">
				<span class="size-[14px] rounded-full bg-[#EB001B]"></span>
				<span class="-ml-[5px] size-[14px] rounded-full bg-[#F79E1B]"></span>
			</span>
			<span class="flex-1 text-[10px] font-medium text-white">Mobile Money</span>
			<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" class="size-[13px] opacity-70">
				<path d="m6 9.5 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</div>
	</div>
</div>
