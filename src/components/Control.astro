---
import ControlRow from './ControlRow.astro';
import SubscriptionsPhone from './SubscriptionsPhone.astro';
import AnalyticsPhone from './AnalyticsPhone.astro';
import MoneySavedPhone from './MoneySavedPhone.astro';

const br = '<br class="hidden sm:inline" />';

// Each pastel card is its own blend of soft radial washes, matching the mockup.
const g1 =
	'[background-image:radial-gradient(46%_40%_at_78%_16%,#0D5560_0%,transparent_72%),radial-gradient(42%_46%_at_98%_38%,#116256_0%,transparent_72%),radial-gradient(40%_34%_at_88%_92%,#35651F_0%,transparent_72%),radial-gradient(44%_40%_at_10%_88%,#0C4A42_0%,transparent_72%),radial-gradient(40%_34%_at_6%_18%,#0F1A16_0%,transparent_72%)] bg-surface';
const g2 =
	'[background-image:radial-gradient(44%_44%_at_6%_46%,#126B54_0%,transparent_72%),radial-gradient(40%_34%_at_86%_12%,#0D5560_0%,transparent_72%),radial-gradient(46%_44%_at_96%_70%,#3A6B22_0%,transparent_72%),radial-gradient(38%_32%_at_16%_92%,#0F5847_0%,transparent_72%)] bg-surface';
const g3 =
	'[background-image:radial-gradient(40%_36%_at_36%_8%,#116256_0%,transparent_72%),radial-gradient(40%_36%_at_88%_16%,#0D5560_0%,transparent_72%),radial-gradient(42%_40%_at_96%_74%,#33601D_0%,transparent_72%),radial-gradient(40%_38%_at_8%_84%,#2F5A1C_0%,transparent_72%),radial-gradient(34%_30%_at_10%_20%,#0F1A16_0%,transparent_72%)] bg-surface';
---

<section id="control" class="relative bg-surface py-24">
	<div class="mx-auto max-w-[1200px] px-6 lg:px-10">
		<p
			data-reveal
			class="mx-auto w-fit text-gradient-brand text-center text-[16px] font-medium"
		>
			Control
		</p>

		<h2
			data-reveal
			class="mx-auto mt-4 text-center text-[clamp(1.5rem,calc(2.411vw-1.93px),1.6875rem)] leading-[1.16] font-bold tracking-[-0.03em] text-ink"
		>
			Put the power in your hands
		</h2>

		<div class="mt-24 flex flex-col gap-28">
			<ControlRow
				title={`Get control over${br} your subscriptions`}
				body={`Achieve instantly finds and tracks your${br} subscriptions. We're there when you need${br} us to cancel services so you don't have to.`}
				cta="Manage my subscriptions"
				gradient={g1}
			>
				<SubscriptionsPhone />
			</ControlRow>

			<ControlRow
				title={`Stay on top of your${br} everyday spending`}
				body={`Get an effortless breakdown of your finances to see${br} where your money is going and how to improve.${br} We'll notify you of important events that need${br} your attention so you're never caught off guard.`}
				cta="Track my spending"
				gradient={g2}
				reverse
			>
				<AnalyticsPhone />
			</ControlRow>

			<ControlRow
				title={`Put your financial${br} goals on autopilot`}
				body={`Turn on autopilot to save money without thinking about${br} it. It learns your habits and saves the right amount at${br} the right time while helping you avoid overdraft fees.`}
				cta="Automate my savings"
				gradient={g3}
			>
				<MoneySavedPhone />
			</ControlRow>
		</div>
	</div>
</section>
