---
/*
  Icons orbit a faint circle around the centred copy. Angles are measured off the
  mockup rather than evenly spaced — the real gaps run 55-67 degrees, not a flat
  60 — so the arrangement keeps the mockup's slightly irregular rhythm.

  Composition is 614px across: a 272px orbit radius plus a 70px icon.
*/
const ORBIT = 44.3; // orbit radius as a % of the composition box
const icons = [
	{ angle: 24.9, name: 'petal' },
	{ angle: 80.8, name: 'paypal' },
	{ angle: 135.7, name: 'wheel' },
	{ angle: 194.8, name: 'bitcoin' },
	{ angle: 256.4, name: 'cash' },
	{ angle: 323.7, name: 'alipay' },
].map((i) => {
	const r = (i.angle * Math.PI) / 180;
	return { ...i, x: 50 + ORBIT * Math.sin(r), y: 50 - ORBIT * Math.cos(r) };
});
---

<section class="relative overflow-hidden bg-white py-20">
	<div class="mx-auto max-w-[1200px] px-6 lg:px-10">
		<div class="relative mx-auto aspect-square w-full max-w-[614px]">
			<!-- the orbit itself, passing through the icon centres -->
			<div
				aria-hidden="true"
				class="absolute top-1/2 left-1/2 size-[88.6%] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#F0F0F0]"
			>
			</div>

			{
				icons.map((icon) => (
					<div
						class="absolute size-[11.4%] -translate-x-1/2 -translate-y-1/2 rounded-[26%] shadow-[0_10px_24px_-8px_rgba(0,0,0,0.22)]"
						style={`left:${icon.x.toFixed(2)}%;top:${icon.y.toFixed(2)}%`}
					>
						{icon.name === 'alipay' && (
							<div class="flex size-full items-center justify-center rounded-[26%] bg-[#1677FF]">
								{/* 支 needs a CJK face; Satoshi has no such glyph */}
								<span
									class="text-[54%] leading-none font-medium text-white"
									style="font-family:'PingFang SC','Hiragino Sans GB','Microsoft YaHei','Noto Sans SC',sans-serif"
								>
									支
								</span>
							</div>
						)}

						{icon.name === 'petal' && (
							<div class="flex size-full items-center justify-center rounded-[26%] bg-[#5B21B6]">
								<svg viewBox="0 0 48 48" class="size-[58%]" fill="#FBBF24">
									{[0, 72, 144, 216, 288].map((a) => (
										<ellipse cx="24" cy="13" rx="6.4" ry="10" transform={`rotate(${a} 24 24)`} />
									))}
								</svg>
							</div>
						)}

						{icon.name === 'paypal' && (
							<div class="flex size-full items-center justify-center rounded-[26%] bg-[linear-gradient(150deg,#2E9BE8,#0B5FC4)]">
								<svg viewBox="0 0 48 48" class="size-[56%]" fill="#fff">
									<path
										d="M18.6 8h11.2c5.6 0 8.8 2.9 8 8.3-.8 5.6-4.9 8.7-10.6 8.7h-4.4l-1.5 9.4c-.1.6-.6 1-1.2 1h-5.2c-.6 0-1-.5-.9-1.1L17.4 9c.1-.6.6-1 1.2-1Z"
										opacity=".55"
									/>
									<path d="M23.6 14h10c5.2 0 8.2 2.8 7.4 8-.8 5.4-4.7 8.4-10 8.4h-4.2l-1.5 9.6c-.1.6-.6 1-1.2 1h-5c-.6 0-1-.5-.9-1.1L22.4 15c.1-.6.6-1 1.2-1Z" />
								</svg>
							</div>
						)}

						{icon.name === 'wheel' && (
							<div class="flex size-full items-center justify-center rounded-[26%] bg-white">
								<div
									class="size-[62%] rounded-full"
									style="background:conic-gradient(#FF3B30,#FF9500,#FFCC00,#34C759,#00C7BE,#30B0C7,#007AFF,#5856D6,#AF52DE,#FF2D55,#FF3B30);-webkit-mask:radial-gradient(circle,transparent 56%,#000 57%);mask:radial-gradient(circle,transparent 56%,#000 57%)"
								/>
							</div>
						)}

						{icon.name === 'bitcoin' && (
							<div class="flex size-full items-center justify-center rounded-[26%] bg-[#F7931A]">
								<svg viewBox="0 0 48 48" class="size-[54%]" fill="none" stroke="#fff" stroke-width="4">
									<path d="M17 10v28M23 7v6M23 35v6M29 7v6M29 35v6" stroke-linecap="round" />
									<path
										d="M17 12h11a6.5 6.5 0 0 1 0 13H17m0 0h13a6.5 6.5 0 0 1 0 13H17"
										stroke-linejoin="round"
									/>
								</svg>
							</div>
						)}

						{icon.name === 'cash' && (
							<div class="flex size-full items-center justify-center rounded-[26%] bg-[#00D54B]">
								<span class="text-[62%] leading-none font-bold text-white">$</span>
							</div>
						)}
					</div>
				))
			}

			<!-- centred copy -->
			<div class="absolute inset-0 flex flex-col items-center justify-center px-[18%] text-center">
				<p
					class="w-fit text-gradient-brand text-[16px] font-medium"
				>
					Connect
				</p>
				<h2
					class="mt-3 text-[clamp(1.375rem,calc(2.679vw-2.14px),1.875rem)] leading-[1.16] font-bold tracking-[-0.03em] text-ink"
				>
					Fits perfectly in<br /> your workflow.
				</h2>
				<p class="mt-4 text-[clamp(0.875rem,calc(1.429vw-1.14px),1rem)] leading-[1.6] text-muted">
					Connect your banks, cards,<br /> and tools — all in one place.
				</p>
			</div>
		</div>
	</div>
</section>
