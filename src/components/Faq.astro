---
/*
  Built on <details>/<summary> so it works without JavaScript and gets keyboard
  support and screen-reader semantics for free. Answers are placeholder copy —
  the mockup only shows the collapsed state.
*/
const faqs = [
	{
		q: 'What is Necta?',
		a: 'Necta is a personal finance app that connects your accounts, tracks your spending and helps you grow your money — all in one place.',
	},
	{
		q: 'Is my data secure?',
		a: 'Yes. Your information is protected with bank-level encryption, and we never sell or share it with third parties.',
	},
	{
		q: 'Can I connect multiple accounts?',
		a: 'You can connect as many banks, cards and wallets as you like and see them together in a single dashboard.',
	},
	{
		q: 'Is there a free plan?',
		a: 'Yes. The free plan covers account syncing, spending insights and budgets. Paid plans add advanced analytics and subscription cancelling.',
	},
	{
		q: 'Does Necta support international users?',
		a: 'Necta works in most countries and supports multi-currency accounts, with new regions added regularly.',
	},
];
---

<section class="relative bg-white py-24">
	<div class="mx-auto max-w-[1200px] px-6 lg:px-10">
		<p
			class="mx-auto w-fit bg-[linear-gradient(90deg,#FF8A3D_0%,#FF5FA2_55%,#B45FE0_100%)] bg-clip-text text-center text-[16px] font-medium text-transparent"
		>
			FAQs
		</p>

		<h2
			class="mx-auto mt-3 text-center text-[clamp(1.625rem,calc(2.679vw-2.14px),1.875rem)] leading-[1.22] font-bold tracking-[-0.03em] text-ink"
		>
			Got questions?<br /> We've got answers.
		</h2>

		<!-- narrow centred column, as in the mockup -->
		<div class="mx-auto mt-12 flex max-w-[580px] flex-col gap-[10px]">
			{
				faqs.map((item) => (
					<details class="group rounded-[14px] bg-[#F7F7F8] transition-colors hover:bg-[#F3F3F5]">
						<summary class="flex min-h-[62px] cursor-pointer list-none items-center justify-between gap-5 px-5 pr-6 [&::-webkit-details-marker]:hidden">
							<span class="text-[15px] font-medium text-ink">{item.q}</span>
							{/* rotating the whole plus 45° turns it into a close icon */}
							<svg
								viewBox="0 0 12 12"
								fill="none"
								stroke="currentColor"
								stroke-width="1.4"
								aria-hidden="true"
								class="size-3 shrink-0 text-ink-soft transition-transform duration-200 group-open:rotate-45"
							>
								<path d="M6 0.6v10.8M0.6 6h10.8" stroke-linecap="round" />
							</svg>
						</summary>
						<p class="px-5 pb-5 text-[15px] leading-[1.6] text-muted">{item.a}</p>
					</details>
				))
			}
		</div>

		<p class="mt-14 text-center text-[16px] text-muted">
			If you can't find the answer or need help, email us at{' '}
			<a href="mailto:help@necta.com" class="underline underline-offset-2 hover:text-ink">
				help@necta.com
			</a>
		</p>
	</div>
</section>
