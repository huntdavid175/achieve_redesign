---
/*
  Built on <details>/<summary> so it works without JavaScript and gets keyboard
  support and screen-reader semantics for free. Answers are placeholder copy —
  the mockup only shows the collapsed state.
*/
const faqs = [
	{
		q: 'What is Achieve by Petra?',
		a: 'Achieve by Petra is an investment app that gives you access to safe personal investment products, so you can invest towards the things that matter to you. Your money is managed by professional fund managers.',
	},
	{
		q: 'How much do I need to start?',
		a: 'DigiSave starts from as low as GHS20.00. Eurobond Trust and Global Tech both start from GHS100.00.',
	},
	{
		q: 'How do I top up my investment?',
		a: 'You can top up at any time with either Mobile Money or your bank. There is no limit on how often you add to an investment.',
	},
	{
		q: 'How long does a withdrawal take?',
		a: 'For DigiSave and Eurobond Trust you can withdraw at any time once your money has been invested. Standard withdrawals are free and are processed and paid at 6pm the next working day, while express withdrawals are instant and carry a 1.2% processing fee. Global Tech funds can only be withdrawn after 6 months.',
	},
	{
		q: 'Which product should I choose?',
		a: 'DigiSave suits emergencies, school fees and other short-term goals. Eurobond Trust is a low-risk option for goals 2 to 5 years away. Global Tech invests in global stocks in USD and is a high risk, high reward fund — between January and December 2025 it returned -14.22%. Past performance does not guarantee future returns.',
	},
	{
		q: 'How do Achieve Points work?',
		a: 'Share your referral link or username. Your referral must sign up using your link and enter your username under "How did you hear about Achieve?". Once they complete sign-up and make their first payment, you each earn 10 Achieve Points, with no limit on referrals. Redeem in multiples of 10 — the value is invested into your DigiSave account and becomes accessible after 30 days.',
	},
];
---

<section class="relative bg-surface py-24">
	<div class="mx-auto max-w-[1200px] px-6 lg:px-10">
		<p
			data-reveal
			class="mx-auto w-fit text-gradient-brand text-center text-[16px] font-medium"
		>
			FAQs
		</p>

		<h2
			data-reveal
			class="mx-auto mt-3 text-center text-[clamp(1.625rem,calc(2.679vw-2.14px),1.875rem)] leading-[1.22] font-bold tracking-[-0.03em] text-ink"
		>
			Got questions?<br /> We've got answers.
		</h2>

		<!-- narrow centred column, as in the mockup -->
		<div data-reveal-group class="mx-auto mt-12 flex max-w-[580px] flex-col gap-[10px]">
			{
				faqs.map((item) => (
					<details data-reveal class="group rounded-[14px] bg-[#0B1512] transition-colors hover:bg-[#12201B]">
						<summary class="flex min-h-[62px] cursor-pointer list-none items-center justify-between gap-5 px-5 pr-6 [&::-webkit-details-marker]:hidden">
							<span class="text-[15px] font-medium text-ink">{item.q}</span>
							{/* rotating the whole plus 45° turns it into a close icon */}
							<svg
								viewBox="0 0 12 12"
								fill="none"
								stroke="currentColor"
								stroke-width="1.4"
								aria-hidden="true"
								class="size-3 shrink-0 text-ink-soft transition-transform duration-200 group-open:rotate-45"
							>
								<path d="M6 0.6v10.8M0.6 6h10.8" stroke-linecap="round" />
							</svg>
						</summary>
						<p class="px-5 pb-5 text-[15px] leading-[1.6] text-muted">{item.a}</p>
					</details>
				))
			}
		</div>

		<p data-reveal class="mt-14 text-center text-[16px] text-muted">
			If you can't find the answer or need help, email us at{' '}
			<a href="mailto:help@achieve.com" class="underline underline-offset-2 hover:text-ink">
				help@achieve.com
			</a>
		</p>
	</div>
</section>
