---
import CapabilityCard from './CapabilityCard.astro';

const br = '<br class="hidden lg:inline" />';

const cards = {
	digisave: {
		icon: 'budget' as const,
		title: 'DigiSave',
		body: `Emergencies, school fees and${br} other short-term goals. From GHS20.`,
	},
	eurobond: {
		icon: 'secure' as const,
		title: 'Eurobond Trust',
		body: `Low-risk investing for 2 to 5${br} year goals. From GHS100.`,
	},
	globaltech: {
		icon: 'insights' as const,
		title: 'Global Tech',
		body: `Global stocks in USD, managed by${br} Black Star Advisors. From GHS100.`,
	},
	topups: {
		icon: 'expense' as const,
		title: 'Mobile Money or bank',
		body: `Top up from MoMo or your bank${br} account, as often as you like.`,
	},
	rewards: {
		icon: 'alerts' as const,
		title: 'Achieve Points',
		body: `Earn 10 points for every friend${br} who joins and starts investing.`,
	},
	oneplace: {
		icon: 'accounts' as const,
		title: 'Every product, one app',
		body: `Hold all three funds side by side${br} and follow them together.`,
	},
};

// stacking order used by the narrow layout
const flat = [
	cards.digisave,
	cards.eurobond,
	cards.globaltech,
	cards.topups,
	cards.rewards,
	cards.oneplace,
];
---

<section id="products" class="relative overflow-hidden bg-surface pt-24 pb-[160px]">
	<!-- faint grid, same rhythm as the hero -->
	<div
		aria-hidden="true"
		class="pointer-events-none absolute inset-0 [background-image:linear-gradient(to_right,#122019_1px,transparent_1px),linear-gradient(to_bottom,#122019_1px,transparent_1px)] [background-size:84px_84px] [mask-image:linear-gradient(to_bottom,#000_0%,#000_55%,transparent_92%)]"
	>
	</div>

	<div class="relative mx-auto max-w-[1200px] px-6 lg:px-10">
		<p
			data-reveal
			class="mx-auto w-fit text-gradient-brand text-center text-[16px] font-medium"
		>
			Our Products
		</p>

		<h2
			data-reveal
			class="mx-auto mt-4 text-center text-[clamp(1.625rem,calc(2.679vw-2.14px),1.875rem)] leading-[1.16] font-bold tracking-[-0.03em] text-ink"
		>
			Safe investment products,<br class="hidden sm:block" /> built around your goals
		</h2>

		<!-- Narrow: a plain stack of all six, device omitted -->
		<div class="mt-11 grid gap-5 sm:grid-cols-2 lg:hidden">
			{flat.map((c) => <CapabilityCard {...c} />)}
		</div>

		<!--
			Wide: two cards centred beneath the heading, then two flanking columns with
			the device between them. The top pair does not line up with the three
			columns below, so it is its own centred row.
		-->
		<div data-reveal-group class="mt-11 hidden justify-center gap-[94px] lg:flex">
			<CapabilityCard {...cards.digisave} class="w-[315px]" />
			<CapabilityCard {...cards.eurobond} class="w-[315px]" />
		</div>

		<!-- The lower row sits ~20px further in on each side than the middle row. -->
		<div data-reveal-group class="mt-[43px] hidden grid-cols-[315px_1fr_315px] lg:grid">
			<div class="flex flex-col gap-[61px]">
				<CapabilityCard {...cards.globaltech} />
				<CapabilityCard {...cards.topups} class="translate-x-5" />
			</div>

			<!--
				Device is absolute so it never drives the row height; it bleeds past the
				section, which clips it. The render is 1024px wide but the phone itself only
				spans 71.6% of that, so 425px here puts the device at the mockup's ~304px.
			-->
			<div class="relative">
				<img
					src="/images/mid-phone.webp"
					alt="The Achieve by Petra app open on a phone, showing DigiSave and fund balances"
					width="1024"
					height="1536"
					loading="lazy"
					decoding="async"
					data-parallax="50"
					class="absolute top-0 left-1/2 w-[425px] max-w-none -translate-x-1/2 select-none"
				/>
			</div>

			<div class="flex flex-col gap-[61px]">
				<CapabilityCard {...cards.rewards} />
				<CapabilityCard {...cards.oneplace} class="-translate-x-5" />
			</div>
		</div>
	</div>

	<!-- hairline rainbow rule along the bottom edge of the section -->
	<div
		aria-hidden="true"
		class="pointer-events-none absolute inset-x-0 bottom-0 h-[3px] [background-image:linear-gradient(90deg,#0F5847_0%,#2C5519_22%,#33601D_44%,#1A5C2E_62%,#0F5F6B_80%,#0E5750_100%)]"
	>
	</div>
</section>
