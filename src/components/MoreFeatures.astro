---
import ReadyCashPhone from './ReadyCashPhone.astro';
import SubscriptionsPhone from './SubscriptionsPhone.astro';
import TransactionsPhone from './TransactionsPhone.astro';

// Card geometry read off the mockup: three ~362px cards on an 18px gutter fill
// the 1120px container exactly; the device sits at 16.4%/16.3% inset, 67.3% wide.
const card =
	'transition-transform duration-300 hover:-translate-y-1 relative aspect-square overflow-hidden rounded-[28px] bg-surface-2';
const device = 'absolute top-[16.3%] left-[16.4%] w-[67.3%]';

const g1 =
	'[background-image:radial-gradient(40%_36%_at_24%_8%,#116256_0%,transparent_72%),radial-gradient(42%_38%_at_92%_18%,#0D5560_0%,transparent_72%),radial-gradient(40%_38%_at_8%_86%,#2F5A1C_0%,transparent_72%),radial-gradient(36%_32%_at_46%_96%,#0F5847_0%,transparent_72%)]';
const g2 =
	'[background-image:radial-gradient(38%_36%_at_10%_18%,#0F1A16_0%,transparent_72%),radial-gradient(40%_40%_at_6%_74%,#0F5847_0%,transparent_72%),radial-gradient(44%_42%_at_96%_82%,#3A6B22_0%,transparent_72%),radial-gradient(36%_34%_at_92%_24%,#0C4A42_0%,transparent_72%)]';
const g3 =
	'[background-image:radial-gradient(42%_36%_at_58%_8%,#0D5560_0%,transparent_72%),radial-gradient(38%_34%_at_96%_16%,#116256_0%,transparent_72%),radial-gradient(40%_38%_at_10%_84%,#2F5A1C_0%,transparent_72%),radial-gradient(38%_34%_at_86%_92%,#0F5847_0%,transparent_72%)]';
---

<section id="rewards" class="relative bg-surface py-24">
	<div class="mx-auto max-w-[1200px] px-6 lg:px-10">
		<p
			data-reveal
			class="mx-auto w-fit text-gradient-brand text-center text-[16px] font-medium"
		>
			Achieve Points
		</p>

		<h2
			data-reveal
			class="mx-auto mt-4 text-center text-[clamp(1.625rem,calc(2.679vw-2.14px),1.875rem)] leading-[1.16] font-bold tracking-[-0.03em] text-ink"
		>
			Refer friends and family,<br class="hidden sm:block" /> earn as they invest.
		</h2>

		<div data-reveal-group class="mt-10 grid gap-[18px] sm:grid-cols-2 lg:grid-cols-3">
			<div data-reveal>
				<div class:list={[card, g1]}>
					<div data-parallax="30" class={device}><ReadyCashPhone /></div>
				</div>
				<h3 class="mt-9 text-[19px] font-medium text-ink">Share Your Referral Link</h3>
				<p class="mt-3 text-[16px] leading-[1.6] text-muted">
					Send your unique link or username to<br class="hidden lg:block" /> anyone ready to start
					investing.
				</p>
			</div>

			<div data-reveal>
				<div class:list={[card, g2]}>
					<div data-parallax="30" class={device}><SubscriptionsPhone /></div>
				</div>
				<h3 class="mt-9 text-[19px] font-medium text-ink">You Both Earn 10 Points</h3>
				<p class="mt-3 text-[16px] leading-[1.6] text-muted">
					When they sign up with your link and make<br class="hidden lg:block" /> their first payment,
					you each earn 10 points.
				</p>
			</div>

			<div data-reveal>
				<div class:list={[card, g3]}>
					<div data-parallax="30" class={device}><TransactionsPhone /></div>
				</div>
				<h3 class="mt-9 text-[19px] font-medium text-ink">Redeem Into DigiSave</h3>
				<p class="mt-3 text-[16px] leading-[1.6] text-muted">
					Redeem in multiples of 10. The value is<br class="hidden lg:block" /> invested for you and
					unlocks after 30 days.
				</p>
			</div>
		</div>
	</div>
</section>
