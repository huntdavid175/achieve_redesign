---
/*
  Full-bleed carousel: the track spans the viewport while the header stays in the
  page container, so neighbouring cards bleed off both edges as in the mockup.
  Cards are 344px square on a 22px gutter.
*/
import { Image } from 'astro:assets';
import user1 from '../assets/users/user1.jpg';
import user2 from '../assets/users/user2.jpg';
import user3 from '../assets/users/user3.jpg';
import user4 from '../assets/users/user4.jpg';
/*
  PLACEHOLDER TESTIMONIALS — written to show the layout, not collected from real
  customers. Replace with quotes you have permission to publish before launch.
*/
// One entry per available photo. `position` is the crop's focal point, as in the hero.
const testimonials = [
	{
		quote: 'I started DigiSave with GHS20 after work one evening. By the next term, the school fees were already sitting there.',
		name: 'Ama Mensah',
		avatar: user1,
		position: '50% 32%',
	},
	{
		quote: 'Eurobond Trust is where my two-year plan lives. I top up on payday and leave it to the fund managers.',
		name: 'Kwabena Owusu',
		avatar: user2,
		position: '50% 32%',
	},
	{
		quote: 'I requested a standard withdrawal and the money came in by 6pm the next working day. Exactly as promised.',
		name: 'Efua Boateng',
		avatar: user3,
		position: '50% 32%',
	},
	{
		quote:
			'I referred three colleagues. They are investing now, and my Achieve Points went straight back into DigiSave.',
		name: 'Adjoa Sarpong',
		avatar: user4,
		position: '50% 32%',
	},
];
---

<section id="special-achiever" class="relative overflow-hidden bg-surface py-24">
	<div class="mx-auto max-w-[1200px] px-6 lg:px-10">
		<p
			data-reveal
			class="mx-auto w-fit text-gradient-brand text-center text-[16px] font-medium"
		>
			Special Achiever
		</p>
		<h2
			data-reveal
			class="mx-auto mt-3 text-center text-[clamp(1.625rem,calc(2.679vw-2.14px),1.875rem)] leading-[1.16] font-bold tracking-[-0.03em] text-ink"
		>
			Meet the achievers
		</h2>
	</div>

	<!--
		Full-bleed track, rendered as three identical sets. The scroll parks in the
		middle set and is rewound by exactly one set width whenever it drifts out,
		so there is always a set of runway in both directions and the seam never
		shows. Three sets (not two) so the loop still works on displays wider than
		a single set.

		Note: no `scroll-smooth` class here on purpose — it would animate the
		rewind, making the jump visible. scrollBy() opts into smooth per call.
	-->
	<div
		data-testimonial-track
		class="mt-10 flex snap-x snap-mandatory gap-[22px] overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
	>
		{
			[...testimonials, ...testimonials, ...testimonials].map((t, i) => (
				<article
					aria-hidden={i >= testimonials.length ? 'true' : undefined}
					class="relative flex w-[344px] shrink-0 snap-start flex-col overflow-hidden rounded-[28px] bg-[linear-gradient(165deg,#0C1613_0%,#0A1310_50%,#081310_100%)] px-9 pt-[60px] pb-[53px] ring-1 ring-[#0F1A16]"
					style="height:344px"
				>
					<div
						aria-hidden="true"
						class="pointer-events-none absolute inset-0 [background-image:radial-gradient(40%_30%_at_12%_96%,#0F5847_0%,transparent_70%),radial-gradient(38%_28%_at_84%_98%,#2C5519_0%,transparent_70%),radial-gradient(34%_26%_at_50%_104%,#0C4A42_0%,transparent_70%)] opacity-80 blur-[22px]"
					/>

					<div class="relative flex gap-[5px]">
						{Array.from({ length: 5 }).map(() => (
							<svg viewBox="0 0 24 24" fill="currentColor" class="size-[18px] text-star">
								<path d="m12 1.9 3.1 6.3 6.9 1-5 4.9 1.2 6.9-6.2-3.3-6.2 3.3L7 14.1l-5-4.9 6.9-1L12 1.9Z" />
							</svg>
						))}
					</div>

					{/* mt-auto bottom-aligns the quote so every card's last line sits level */}
					<div class="relative mt-auto">
						<p class="text-[17px] leading-[1.45] text-ink">{t.quote}</p>
						<div class="mt-6 flex items-center gap-3">
							<Image
								src={t.avatar}
								alt=""
								width={64}
								style={`object-position:${t.position}`}
								class="size-8 shrink-0 rounded-full object-cover ring-2 ring-surface-2"
							/>
							<span class="text-[15px] font-medium text-ink-soft">{t.name}</span>
						</div>
					</div>
				</article>
			))
		}
	</div>

	<div class="mt-8 flex items-center justify-center gap-2">
		<button
			type="button"
			data-testimonial-prev
			aria-label="Previous testimonial"
			class="flex size-8 items-center justify-center rounded-full bg-accent text-accent-ink transition hover:bg-accent/85"
		>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="size-[13px]">
				<path d="M14 5.5 7.5 12l6.5 6.5" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</button>
		<button
			type="button"
			data-testimonial-next
			aria-label="Next testimonial"
			class="flex size-8 items-center justify-center rounded-full bg-accent text-accent-ink transition hover:bg-accent/85"
		>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="size-[13px]">
				<path d="m10 5.5 6.5 6.5-6.5 6.5" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</button>
	</div>
</section>

<script>
	const AUTOPLAY_MS = 1000;

	const track = document.querySelector<HTMLElement>('[data-testimonial-track]');
	const prev = document.querySelector<HTMLButtonElement>('[data-testimonial-prev]');
	const next = document.querySelector<HTMLButtonElement>('[data-testimonial-next]');

	if (track && prev && next) {
		// measured from the DOM so it survives any width change
		const step = () => {
			const cards = track.querySelectorAll<HTMLElement>('article');
			return cards.length > 1
				? cards[1].offsetLeft - cards[0].offsetLeft
				: (cards[0]?.offsetWidth ?? 0);
		};
		// the list is rendered as three identical sets
		const SETS = 3;
		const setWidth = () => track.scrollWidth / SETS;

		// instant, un-animated position change
		const jumpTo = (x: number) => {
			const prevBehavior = track.style.scrollBehavior;
			track.style.scrollBehavior = 'auto';
			track.scrollLeft = x;
			track.style.scrollBehavior = prevBehavior;
		};

		/*
		 * Keep the scroll inside the FIRST set, i.e. [0, w).
		 *
		 * Rewinding at 2*w instead looks natural but is unreachable: max scrollLeft
		 * is 3*w - clientWidth, so on a 1920px display that is 3570 against a 3660
		 * threshold. The scroll then parks at the end and everything jams. Rewinding
		 * at w only ever needs to reach w + step, which fits at any real width.
		 */
		const normalize = () => {
			const w = setWidth();
			if (w > 0 && track.scrollLeft >= w) jumpTo(track.scrollLeft - w);
		};

		const go = (dir: number) => {
			const s = step();
			// stepping back off the start: hop forward a set first, then scroll back
			if (dir < 0 && track.scrollLeft < s) jumpTo(track.scrollLeft + setWidth());
			track.scrollBy({ left: dir * s, behavior: 'smooth' });
		};

		let settle: number;
		track.addEventListener('scroll', () => {
			clearTimeout(settle);
			settle = window.setTimeout(normalize, 120);
		});
		window.addEventListener('resize', normalize);

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		let timer: number | undefined;
		const stop = () => {
			if (timer) window.clearInterval(timer);
			timer = undefined;
		};
		const start = () => {
			stop();
			if (reduced.matches) return;
			timer = window.setInterval(() => go(1), AUTOPLAY_MS);
		};

		// a manual nudge restarts the clock rather than fighting it
		prev.addEventListener('click', () => {
			go(-1);
			start();
		});
		next.addEventListener('click', () => {
			go(1);
			start();
		});

		// hold still while the reader is engaged, or the tab is in the background
		track.addEventListener('pointerenter', stop);
		track.addEventListener('pointerleave', start);
		track.addEventListener('focusin', stop);
		track.addEventListener('focusout', start);
		document.addEventListener('visibilitychange', () =>
			document.hidden ? stop() : start()
		);
		reduced.addEventListener('change', start);

		start();
	}
</script>
