---
// Placeholder brand marks — swap for real client logos when they land.
const brands = [
	{ name: 'Lumina', icon: 'lumina' },
	{ name: 'Synergy', icon: 'synergy' },
	{ name: 'Vortex', icon: 'vortex' },
	{ name: 'Enigma', icon: 'enigma' },
	{ name: 'Velocity', icon: 'velocity' },
	{ name: 'Spectrum', icon: 'spectrum' },
];

// duplicated so the -50% translate loops seamlessly
const strip = [...brands, ...brands];
---

<div class="py-8" aria-label="Trusted by">
	<!--
		Clipped to the page container rather than the viewport, so the strip lines up
		with the rest of the layout; the mask fades the logos out at those same edges
		instead of cutting them off hard.
	-->
	<div
		class="relative mx-auto max-w-[1200px] overflow-hidden px-6 [mask-image:linear-gradient(to_right,transparent_0,#000_7%,#000_93%,transparent_100%)] lg:px-10"
	>
		<div class="animate-marquee flex w-max items-center">
		{
			strip.map((brand, i) => (
				<div
					class="mr-14 flex shrink-0 items-center gap-2 text-[#B4B4B4]"
					aria-hidden={i >= brands.length ? 'true' : undefined}
				>
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-6 shrink-0">
						{brand.icon === 'lumina' && (
							<Fragment>
								<path
									d="M12 1.6a10.4 10.4 0 1 0 0 20.8 10.4 10.4 0 0 0 0-20.8Zm0 2.6a7.8 7.8 0 1 1 0 15.6 7.8 7.8 0 0 1 0-15.6Z"
									opacity=".45"
								/>
								<path d="M12 5.6a6.4 6.4 0 0 1 4.5 10.9A6.4 6.4 0 0 0 12 5.6Z" />
								<circle cx="12" cy="12" r="3.1" />
							</Fragment>
						)}
						{brand.icon === 'synergy' && (
							<Fragment>
								<path d="M4.2 3.4 15 12 4.2 20.6V3.4Z" opacity=".45" />
								<path d="M9.6 7.7 17.4 12l-7.8 4.3V7.7Z" />
							</Fragment>
						)}
						{brand.icon === 'vortex' && (
							<Fragment>
								<path d="M12 2.2c4 2.3 6.4 5.6 6.4 9.4 0 4.2-2.9 7.4-6.4 10.2V2.2Z" opacity=".45" />
								<path d="M12 2.2v19.6C8.5 19 5.6 15.8 5.6 11.6c0-3.8 2.4-7.1 6.4-9.4Z" />
								<circle cx="12" cy="10.4" r="2.6" opacity=".55" />
							</Fragment>
						)}
						{brand.icon === 'enigma' && (
							<Fragment>
								<path d="M10.7 1.8h2.6v20.4h-2.6z" />
								<path d="M2.4 6.6 3.7 4.3l17.7 10.2-1.3 2.3z" opacity=".55" />
								<path d="M20.3 4.3l1.3 2.3L3.9 16.8l-1.3-2.3z" opacity=".55" />
							</Fragment>
						)}
						{brand.icon === 'velocity' && (
							<Fragment>
								<path
									d="M12 1.6a10.4 10.4 0 1 0 0 20.8 10.4 10.4 0 0 0 0-20.8Zm0 2.6a7.8 7.8 0 1 1 0 15.6 7.8 7.8 0 0 1 0-15.6Z"
									opacity=".45"
								/>
								<path d="M14.6 6.4v7.2a2.6 2.6 0 1 1-2.6-2.6h.9V6.4h1.7Z" />
							</Fragment>
						)}
						{brand.icon === 'spectrum' && (
							<Fragment>
								<path d="M2.6 18.4c0-7.1 5.7-12.8 12.8-12.8v3.4c-5.2 0-9.4 4.2-9.4 9.4H2.6Z" opacity=".4" />
								<path d="M7.4 18.4c0-4.4 3.6-8 8-8v3.4a4.6 4.6 0 0 0-4.6 4.6H7.4Z" opacity=".7" />
								<circle cx="15.4" cy="18.4" r="2.4" />
							</Fragment>
						)}
					</svg>
					<span class="text-[21px] font-medium whitespace-nowrap">{brand.name}</span>
				</div>
			))
		}
		</div>
	</div>
</div>
