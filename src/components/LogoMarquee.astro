---
// Client brand marks, drawn inline so they inherit the muted marquee colour.
// `label` is omitted where the mark already contains the wordmark (MTN).
const brands = [
	{
		name: 'Paystack',
		icon: 'paystack',
		label: 'paystack',
		viewBox: '0 0 24 24',
		class: 'size-6',
	},
	{
		name: 'MTN',
		icon: 'mtn',
		viewBox: '320 320 1280 640',
		class: 'h-8 w-auto',
	},
	{
		name: 'Petra',
		icon: 'petra',
		label: 'PETRA',
		labelClass: 'tracking-[0.14em]',
		viewBox: '0 0 24 24',
		class: 'size-6',
	},
];

// repeated so the -50% translate loops seamlessly and the strip stays wider
// than the container with only three brands
const strip = [...brands, ...brands, ...brands, ...brands];
---

<div class="py-8" aria-label="Trusted by">
	<!--
		Clipped to the page container rather than the viewport, so the strip lines up
		with the rest of the layout; the mask fades the logos out at those same edges
		instead of cutting them off hard.
	-->
	<div
		class="relative mx-auto max-w-[1200px] overflow-hidden px-6 [mask-image:linear-gradient(to_right,transparent_0,#000_7%,#000_93%,transparent_100%)] lg:px-10"
	>
		<div class="animate-marquee flex w-max items-center">
		{
			strip.map((brand, i) => (
				<div
					class="mr-14 flex shrink-0 items-center gap-2 text-[#5F7972]"
					aria-hidden={i >= brands.length ? 'true' : undefined}
				>
					<svg
						viewBox={brand.viewBox}
						fill="currentColor"
						aria-hidden="true"
						class={`shrink-0 ${brand.class}`}
					>
						{brand.icon === 'paystack' && (
							<Fragment>
								<rect x="3" y="5" width="13" height="2.7" rx="0.6" opacity=".55" />
								<rect x="3" y="9" width="18" height="2.7" rx="0.6" />
								<rect x="3" y="13" width="15.5" height="2.7" rx="0.6" />
								<rect x="3" y="17" width="8" height="2.7" rx="0.6" opacity=".55" />
							</Fragment>
						)}
						{brand.icon === 'mtn' && (
							<path d="M960 320c-353.46 0-640 143.27-640 320s286.54 320 640 320 640-143.27 640-320-286.54-320-640-320zm0 589.48c-325.56 0-589.48-120.65-589.48-269.48S634.44 370.52 960 370.52 1549.48 491.17 1549.48 640 1285.56 909.48 960 909.48zm-80.71-325.62v-50.53h180.55v50.53h-65v162.81H944.3V583.86zm398.49-50.53v213.34h-50.52l-91.63-127v127h-50.52V533.33h50.52l91.63 127v-127zM640.72 746.67V533.33h50.52l56.13 86.34 56.13-86.34H854v213.34h-50.5V626l-38.32 58.9h-35.62L691.24 626v120.67z" />
						)}
						{brand.icon === 'petra' && (
							<Fragment>
								<path
									fill-rule="evenodd"
									clip-rule="evenodd"
									d="M12 2.6 21.4 21H2.6L12 2.6Zm0 6.4L7.4 18.4h9.2L12 9Z"
								/>
								<path d="M12 12.4 15 18.4H9l3-6Z" opacity=".55" />
							</Fragment>
						)}
					</svg>
					{brand.label && (
						<span class={`text-[21px] font-medium whitespace-nowrap ${brand.labelClass ?? ''}`}>
							{brand.label}
						</span>
					)}
				</div>
			))
		}
		</div>
	</div>
</div>
