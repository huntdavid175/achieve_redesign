---
/*
  Placeholder artwork for "Redeem Into DigiSave" — the recent activity list.
  Marks are stand-in coloured discs, not real logos.
*/
const tx = [
	{ name: 'Points redeemed', when: 'Today, at 11:48 AM', amount: '40.00', mark: 'bg-[#0F7A4A]' },
	{ name: 'DigiSave top-up', when: '12 Aug 2026, at 05:50 PM', amount: '250.00', mark: 'bg-[#12100F]' },
	{ name: 'Referral bonus', when: '04 Aug 2026, at 10:48 AM', amount: '10.00', mark: 'bg-[#2C2C2C]' },
	{
		name: 'Eurobond Trust',
		when: '28 Jul 2026, at 08:59 PM',
		amount: '800.00',
		mark: 'bg-[linear-gradient(150deg,#8FB6D9,#4E7BA6)]',
	},
	{
		name: 'MoMo top-up',
		when: '10 Jul 2026',
		amount: '120.00',
		mark: 'bg-[linear-gradient(150deg,#E8B79C,#C98A6D)]',
	},
];
---

<div class="relative aspect-[860/1864] w-full overflow-hidden rounded-[24px] bg-[#08090A] ring-1 ring-white/10">
	<p class="px-4 pt-6 text-[15px] font-bold text-white">Recent Activity</p>

	<div class="mt-4 flex flex-col gap-[18px] px-4">
		{
			tx.map((t) => (
				<div class="flex items-center gap-2.5">
					<span class:list={['size-[30px] shrink-0 rounded-full', t.mark]} />
					<span class="min-w-0 flex-1">
						<span class="flex items-center gap-1">
							<span class="truncate text-[11px] font-medium text-white">{t.name}</span>
							<svg viewBox="0 0 24 24" fill="#3ED98F" class="size-[8px] shrink-0">
								<path d="M18 6 6 18M15 18H6V9" stroke="#3ED98F" stroke-width="3" fill="none" />
							</svg>
						</span>
						<span class="mt-[2px] block truncate text-[7.5px] text-white/40">{t.when}</span>
					</span>
					<span class="shrink-0 text-[10px] text-white">+&nbsp;GHS {t.amount}</span>
				</div>
			))
		}
	</div>
</div>
