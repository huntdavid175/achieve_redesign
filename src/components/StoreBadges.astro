---
interface Props {
	class?: string;
	/** ~15% smaller, as used in the closing call-to-action */
	compact?: boolean;
}

const { class: className = '', compact = false } = Astro.props;

const pad = compact ? 'px-3.5 py-3' : 'px-4 py-3.5';
const title = compact ? 'text-[17px]' : 'text-[20px]';
const kicker = compact ? 'text-[9px]' : 'text-[10px]';
const appleIcon = compact ? 'size-6' : 'size-7';
const playIcon = compact ? 'size-[22px]' : 'size-[26px]';
---

<div class={`flex flex-wrap items-center gap-4 ${className}`}>
	<a
		href="#"
		class:list={['inline-flex items-center gap-3 rounded-[14px] bg-ink text-white transition hover:opacity-90', pad]}
	>
		<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class:list={[appleIcon]}>
			<path
				d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08ZM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25Z"
			></path>
		</svg>
		<span class="flex flex-col leading-none">
			<span class:list={['font-medium tracking-[0.06em]', kicker]}>GET IT ON</span>
			<span class:list={['mt-1 font-bold tracking-tight', title]}>App Store</span>
		</span>
	</a>

	<a
		href="#"
		class:list={['inline-flex items-center gap-3 rounded-[14px] border border-[#E6E6E6] bg-white text-ink transition hover:border-[#d4d4d4]', pad]}
	>
		<svg viewBox="0 0 512 512" aria-hidden="true" class:list={[playIcon]}>
			<defs>
				<linearGradient id="gp-body" x1="25" y1="0" x2="304" y2="512" gradientUnits="userSpaceOnUse">
					<stop offset="0" stop-color="#00E1FF"></stop>
					<stop offset="1" stop-color="#00A0FF"></stop>
				</linearGradient>
			</defs>
			<path
				d="M47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0Z"
				fill="url(#gp-body)"></path>
			<path d="M325.3 234.3 104.6 13l280.8 161.2-60.1 60.1Z" fill="#00F076"></path>
			<path
				d="m472.2 225.6-58.9-34.1-65.7 64.5 65.7 64.5 60-34.1c18-14.3 18-46.5-1.1-60.8Z"
				fill="#FFCE00"></path>
			<path d="M104.6 499l280.8-161.2-60.1-60.1L104.6 499Z" fill="#FF3A44"></path>
		</svg>
		<span class="flex flex-col leading-none">
			<span class:list={['font-medium tracking-[0.06em]', kicker]}>GET IT ON</span>
			<span class:list={['mt-1 font-bold tracking-tight', title]}>Google Play</span>
		</span>
	</a>
</div>
