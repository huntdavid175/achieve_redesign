---
/*
  Placeholder artwork for "Pick a goal, start investing" — the portfolio list.
*/
const holdings = [
	{ name: 'DigiSave', price: 'GHS 2,450', dot: 'bg-[#34D3A0]' },
	{ name: 'Eurobond Trust', price: 'GHS 4,300', dot: 'bg-[#A78BFA]' },
	{ name: 'Global Tech', price: 'GHS 1,200', dot: 'bg-[#FBD34D]' },
	{ name: 'School fees goal', price: 'GHS 800', dot: 'bg-[#3B82F6]' },
	{ name: 'Achieve Points', price: '40 pts', dot: 'bg-[#F0A32F]' },
];
---

<div class="relative aspect-[860/1864] w-full overflow-hidden rounded-[26px] bg-[#08090A] ring-1 ring-white/10">
	<div class="flex items-center px-5 pt-6">
		<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" class="size-[15px]">
			<path d="M14 5.5 7.5 12l6.5 6.5" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
		<span class="flex-1 text-center text-[15px] font-bold text-white">My Investments</span>
		<span class="size-[15px]"></span>
	</div>

	<div class="mt-7 flex items-start justify-between px-5">
		<div>
			<p class="text-[13px] text-white/50">Total invested</p>
			<p class="mt-1 text-[19px] font-medium text-white">GHS 8,750</p>
		</div>
		<span class="mt-3 flex size-[34px] shrink-0 items-center justify-center rounded-full bg-[#1C1D1F]">
			<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" class="size-[13px]">
				<path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</span>
	</div>

	<div class="mt-4 px-5">
		{
			holdings.map((s, i) => (
				<div
					class:list={[
						'flex items-center justify-between py-[13px]',
						i > 0 && 'border-t border-white/10',
					]}
				>
					<span class="flex items-center gap-2.5">
						<span class:list={['size-[9px] rounded-full', s.dot]} />
						<span class="text-[14px] text-white/85">{s.name}</span>
					</span>
					<span class="text-[14px] font-medium text-white">{s.price}</span>
				</div>
			))
		}
	</div>
</div>
