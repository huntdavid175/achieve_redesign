---
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
	viewBox="0 0 40 40"
	fill="none"
	aria-hidden="true"
	class={`shrink-0 ${className}`}
>
	<defs>
		<linearGradient id="necta-mark" x1="4" y1="2" x2="36" y2="38" gradientUnits="userSpaceOnUse">
			<stop offset="0" stop-color="#8FD6F2"></stop>
			<stop offset="0.34" stop-color="#E9B6E6"></stop>
			<stop offset="0.62" stop-color="#F79FC0"></stop>
			<stop offset="1" stop-color="#FFC46B"></stop>
		</linearGradient>
	</defs>
	<rect width="40" height="40" rx="12.5" fill="url(#necta-mark)"></rect>
	<path
		d="M11.2 28.8c0-9.7 6.9-17 17.6-17.6.6 9.8-6.7 17.6-17.6 17.6Z"
		fill="#fff"></path>
</svg>
