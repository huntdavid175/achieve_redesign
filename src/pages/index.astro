<Layout
	title="Achieve — Everything you need to understand your money"
	description="Track spending, manage accounts, and grow your money with real-time insights built for modern life."
>
	<Navbar />
	<main>
		<Hero />
		<LogoMarquee />
		<Features />
		<Capabilities />
		<Control />
		<MoreFeatures />
		<Connect />
		<Testimonials />
		<Faq />
		<DownloadCta />
	</main>
	<Footer />
	<ScrollFx />
</Layout>
